+//
+// =====================================================================
+// METHOD3: Dynamic per-allocation BAR1 P2P mapping.
+//
+// Static BAR1 P2P (kbusGetBar1P2PDmaInfo_HAL) encodes peer addresses as
+// remoteBar1PhysBase + fbPhysOffset, which only works when the remote GPU's
+// whole framebuffer is identity-mapped into BAR1 -- i.e. BAR1 >= FB. On the
+// leaked-VBIOS 48GB RTX 4090 (AD102, 32GB BAR1 / 48GB FB) static BAR1 cannot
+// be enabled, so that scheme breaks.
+//
+// Instead, for each peer-shared allocation we map *that allocation* into the
+// remote GPU's BAR1 via the generic dynamic aperture (kbusMapFbAperture_HAL,
+// the same primitive GPUDirect-RDMA / third_party_p2p.c uses), describe the
+// resulting BAR1 window as sysmem, IOMMU-map it into the source GPU's IOVA,
+// and encode the source PTEs as windowDmaBase + offsetWithinAllocation. The
+// remote BAR1 GMMU indirection lets the allocation live anywhere in the 48GB
+// FB while only its BAR1 *window* (bounded by total peer-shared bytes, ~tens
+// of MB for NCCL) needs to fit in the 32GB aperture. Lifecycle is tied to the
+// duped peer-memory handle: created lazily on first PTE build, destroyed in
+// nvGpuOpsFreeDupedHandle().
+//
+// The admission check reserves a remote-GPU BAR1 budget in KernelBus state; the
+// native BAR1 allocator remains the final authority and may still reject a
+// fragmented window. This counter covers Method3 mappings only, not unrelated
+// BAR1 consumers.
+// =====================================================================
+//
+typedef struct gpuDynBar1P2PMapping
+{
+    struct gpuDynBar1P2PMapping *pNext;
+    NvHandle            hDupMemory;        // key: duped peer-mem handle in session
+    NvU32               mappingGpuInstance;
+    NvU32               mappingGpuId;
+    NvU32               remoteGpuInstance;
+    NvU32               remoteGpuId;       // stable attach-table identity
+    OBJGPU             *pMappingGpu;       // source/IOMMU owner; validated before teardown
+    OBJGPU             *pRemoteGpu;        // FB owner (peer)
+    NvU64               mappingBar1Generation;
+    NvU64               remoteBar1Generation;
+    MEMORY_DESCRIPTOR  *pAllocMemDesc;     // peer allocation, mapped into remote BAR1
+    MEMORY_DESCRIPTOR  *pWindowMemDesc;    // ADDR_SYSMEM desc of the remote BAR1 window
+    MemoryArea          memArea;           // remote BAR1 VA mapping (for kbusUnmapFbAperture)
+    NvU64               size;
+    NvU64               bar1MappedBytes;   // bytes this logical map charges to remote BAR1 budget
+    NvU32               iovaspaceId;       // source GPU IOVA space the window is mapped into
+    RmPhysAddr          windowDmaBase;     // source-visible IOVA of window byte 0
+    NvBool              bBar1Mapped;       // BAR1 aperture remains installed
+    NvBool              bIommuMapped;      // source IOVA mapping remains installed
+    NvBool              bAllocMemDescRef;  // extra ref held until BAR1 unmap
+    NvBool              bCleanupPending;   // create failed; only teardown/retry is allowed
+    NvBool              bDestroying;       // prevents concurrent use/free while unmapping
+    NvU32               activeUsers;       // PTE/phys builders holding a short lease
+} gpuDynBar1P2PMapping;
+
+// Caller must hold rmSubDevice->pDynBar1Mutex.
+static gpuDynBar1P2PMapping *
+_nvGpuOpsDynBar1Find(subDeviceDesc *rmSubDevice, NvHandle hDupMemory)
+{
+    gpuDynBar1P2PMapping *pMap = NULL;
+    for (pMap = rmSubDevice->pDynBar1List; pMap != NULL; pMap = pMap->pNext)
+    {
+        if (pMap->hDupMemory == hDupMemory)
+            return pMap;
+    }
+    return NULL;
+}
+
+// Caller must have completed the remote BAR1 unmap before dropping the record.
+static void
+_nvGpuOpsDynBar1Remove(subDeviceDesc *rmSubDevice, gpuDynBar1P2PMapping *pMap)
+{
+    gpuDynBar1P2PMapping *pPrev;
+    gpuDynBar1P2PMapping *pCur;
+
+    portSyncMutexAcquire(rmSubDevice->pDynBar1Mutex);
+    for (pPrev = NULL, pCur = rmSubDevice->pDynBar1List;
+         pCur != NULL;
+         pPrev = pCur, pCur = pCur->pNext)
+    {
+        if (pCur == pMap)
+        {
+            if (pPrev != NULL)
+                pPrev->pNext = pCur->pNext;
+            else
+                rmSubDevice->pDynBar1List = pCur->pNext;
+            break;
+        }
+    }
+    portSyncMutexRelease(rmSubDevice->pDynBar1Mutex);
+
+    NV_ASSERT(pCur == pMap);
+    portMemFree(pMap);
+}
+
+// kbusUnmapFbAperture_GM107 frees the MemoryArea range array even when it
+// returns an error. Keep the original array in the tracking record and pass a
+// disposable copy on every attempt so a failed unmap remains retryable.
+static NV_STATUS
+_nvGpuOpsDynBar1Unmap(gpuDynBar1P2PMapping *pMap, KernelBus *pRemoteKernelBus)
+{
+    MemoryRange *pUnmapRanges;
+    MemoryArea unmapArea;
+    NvU64 rangesBytes;
+    NV_STATUS status;
+
+    if ((pMap == NULL) || (pRemoteKernelBus == NULL) ||
+        (pMap->pRemoteGpu == NULL) || (pMap->pAllocMemDesc == NULL) ||
+        (pMap->memArea.pRanges == NULL) || (pMap->memArea.numRanges == 0) ||
+        !portSafeMulU64(pMap->memArea.numRanges, sizeof(MemoryRange), &rangesBytes))
+    {
+        return NV_ERR_INVALID_STATE;
+    }
+
+    pUnmapRanges = portMemAllocNonPaged(rangesBytes);
+    if (pUnmapRanges == NULL)
+        return NV_ERR_NO_MEMORY;
+
+    portMemCopy(pUnmapRanges, rangesBytes, pMap->memArea.pRanges, rangesBytes);
+    unmapArea.pRanges = pUnmapRanges;
+    unmapArea.numRanges = pMap->memArea.numRanges;
+
+    status = kbusUnmapFbAperture_HAL(pMap->pRemoteGpu, pRemoteKernelBus,
+                                     pMap->pAllocMemDesc, unmapArea,
+                                     BUS_MAP_FB_FLAGS_MAP_UNICAST);
+    if (status == NV_OK)
+    {
+        portMemFree(pMap->memArea.pRanges);
+        pMap->memArea.pRanges = NULL;
+        pMap->memArea.numRanges = 0;
+    }
+
+    return status;
+}
+
+//
+// Map pAllocMemDesc (owned by pRemoteGpu) into pRemoteGpu's BAR1, IOMMU-map
+// the window into pMappingGpu's IOVA, track it, and return the source-visible
+// DMA base. Caller must hold rmSubDevice->pDynBar1Mutex and the RMAPI lock;
+// the remote GPU lock is acquired here if not already held.
+//
+static NV_STATUS
+_nvGpuOpsDynBar1Create(subDeviceDesc *rmSubDevice,
+                       OBJGPU *pMappingGpu,
+                       OBJGPU *pRemoteGpu,
+                       MEMORY_DESCRIPTOR *pAllocMemDesc,
+                       NvHandle hDupMemory,
+                       RmPhysAddr *pWindowDmaBase)
+{
+    //
+    // Window size = memdescGetSize() (the requested allocation size). UVM is told
+    // exactly this size via nvGpuOpsFillGpuMemoryInfo, so its external-map requests
+    // never exceed it; and kbusMapFbAperture -> memdescCreateSubMem caps the
+    // mappable range at pMemDesc->Size (== memdescGetSize), so a larger value
+    // (e.g. aligned ActualSize) would fail the sub-mem create when ActualSize >
+    // Size. The PTE/physaddr builders only encode offsets within this range.
+    //
+    const NvU64         DYN_BAR1_P2P_RESERVE = 64ULL << 20;   // keep 64MB of BAR1 free
+    NV_STATUS           status;
+    KernelBus          *pRemoteKernelBus;
+    KernelBus          *pMappingKernelBus;
+    MEMORY_DESCRIPTOR  *pWin = NULL;
+    MemoryArea          memArea;
+    NvU64               mapSize;
+    RmPhysAddr          windowPhys;
+    RmPhysAddr          dmaBase = 0;
+    NvU64               bar1Size;
+    NvU32               iovaspaceId;
+    RmPhysAddr          dmaWindowEndAddr;
+    RmPhysAddr          dmaBaseFromMap;
+    PIOVAMAPPING        pIovaMap = NULL;
+    gpuDynBar1P2PMapping *pMap = NULL;
+    NvBool              bRemoteLockTaken;
+    NvBool              bRemoteLockAcquired = NV_FALSE;
+    NvBool              bBudgetReserved = NV_FALSE;
+    NvBool              bMapped = NV_FALSE;
+    NvBool              bIommuMapped = NV_FALSE;
+    NvU32               releaseStatus;
+
+    portMemSet(&memArea, 0, sizeof(memArea));
+
+    if ((rmSubDevice == NULL) || (pMappingGpu == NULL) || (pRemoteGpu == NULL) ||
+        (pAllocMemDesc == NULL) || (pWindowDmaBase == NULL))
+    {
+        return NV_ERR_INVALID_ARGUMENT;
+    }
+
+    *pWindowDmaBase = 0;
+    pRemoteKernelBus = GPU_GET_KERNEL_BUS(pRemoteGpu);
+    pMappingKernelBus = GPU_GET_KERNEL_BUS(pMappingGpu);
+    if ((pRemoteKernelBus == NULL) || (pMappingKernelBus == NULL))
+        return NV_ERR_INVALID_STATE;
+
+    mapSize = memdescGetSize(pAllocMemDesc);
+    iovaspaceId = pMappingGpu->busInfo.iovaspaceId;
+    bRemoteLockTaken = rmDeviceGpuLockIsOwner(gpuGetInstance(pRemoteGpu));
+
+    if (mapSize == 0)
+        return NV_ERR_INVALID_ARGUMENT;
+
+    // memdescMapIommu() is a no-op for this sentinel and still returns NV_OK.
+    // A dynamic window must have a real source-GPU IOVA domain.
+    if (iovaspaceId == NV_IOVA_DOMAIN_NONE)
+        return NV_ERR_INVALID_STATE;
+
+    // Allocate the tracking record before touching the remote aperture.  If a
+    // later validation/unmap fails, the record can retain the live aperture
+    // and be retried by nvGpuOpsFreeDupedHandle() instead of becoming an
+    // unowned BAR1 leak.
+    pMap = portMemAllocNonPaged(sizeof(*pMap));
+    if (pMap == NULL)
+        return NV_ERR_NO_MEMORY;
+    portMemSet(pMap, 0, sizeof(*pMap));
+    pMap->hDupMemory         = hDupMemory;
+    pMap->mappingGpuInstance = gpuGetInstance(pMappingGpu);
+    pMap->mappingGpuId       = pMappingGpu->gpuId;
+    pMap->remoteGpuInstance  = gpuGetInstance(pRemoteGpu);
+    pMap->remoteGpuId        = pRemoteGpu->gpuId;
+    pMap->pMappingGpu        = pMappingGpu;
+    pMap->pRemoteGpu         = pRemoteGpu;
+    pMap->mappingBar1Generation =
+        pMappingKernelBus->p2pPcieBar1.dynamicBar1P2pGeneration;
+    pMap->remoteBar1Generation =
+        pRemoteKernelBus->p2pPcieBar1.dynamicBar1P2pGeneration;
+    pMap->pAllocMemDesc      = pAllocMemDesc;
+    pMap->size               = mapSize;
+    pMap->iovaspaceId        = iovaspaceId;
+
+    // Fabric-adjusted descriptors are released by the caller as soon as this
+    // helper returns. Hold one reference for the lifetime of the BAR1 map.
+    memdescAddRef(pAllocMemDesc);
+    pMap->bAllocMemDescRef = NV_TRUE;
+
+    // 1. Map the allocation into the remote GPU's BAR1 (dynamic aperture).
+    //    No ALLOW_DISCONTIG: the linear encode requires a single contiguous BAR1
+    //    VA range. Without the flag, kbusMapFbAperture forces a single range (FB
+    //    scatter is still handled internally) or fails -- which is correct here.
+    if (!bRemoteLockTaken)
+    {
+        status = rmDeviceGpuLocksAcquire(pRemoteGpu, GPUS_LOCK_FLAGS_NONE,
+                                          RM_LOCK_MODULES_P2P);
+        if (status != NV_OK)
+            goto fail;
+        bRemoteLockAcquired = NV_TRUE;
+    }
+
+    bar1Size = kbusGetPciBarSize(pRemoteKernelBus, 1);
+
+    // The counter is on the remote KernelBus and is updated while its GPU lock
+    // is held.  This is global across source subdevices and RM clients for the
+    // BAR1 owner; the native allocator remains the final authority for other
+    // BAR1 users and fragmentation.
+    if ((bar1Size == 0) ||
+        (bar1Size <= DYN_BAR1_P2P_RESERVE) ||
+        (pRemoteKernelBus->p2pPcieBar1.dynamicBar1P2pMappedBytes >
+             (bar1Size - DYN_BAR1_P2P_RESERVE)) ||
+        (mapSize > (bar1Size - DYN_BAR1_P2P_RESERVE) -
+             pRemoteKernelBus->p2pPcieBar1.dynamicBar1P2pMappedBytes) ||
+        (mapSize > NV_U64_MAX -
+             pRemoteKernelBus->p2pPcieBar1.dynamicBar1P2pMappedBytes))
+    {
+        NV_PRINTF(LEVEL_ERROR,
+                  "METHOD3: dynamic BAR1 P2P budget exceeded on GPU%u: mapped 0x%llx + "
+                  "0x%llx + reserve 0x%llx > BAR1 0x%llx\n",
+                  gpuGetInstance(pRemoteGpu),
+                  pRemoteKernelBus->p2pPcieBar1.dynamicBar1P2pMappedBytes,
+                  mapSize, DYN_BAR1_P2P_RESERVE, bar1Size);
+        status = NV_ERR_INSUFFICIENT_RESOURCES;
+        goto fail;
+    }
+
+    pRemoteKernelBus->p2pPcieBar1.dynamicBar1P2pMappedBytes += mapSize;
+    // Record the provisional charge immediately so a native BAR1 map failure
+    // releases the same bytes instead of leaking the software budget.
+    pMap->bar1MappedBytes = mapSize;
+    bBudgetReserved = NV_TRUE;
+
+    status = kbusMapFbAperture_HAL(pRemoteGpu, pRemoteKernelBus,
+                                   pAllocMemDesc,
+                                   mrangeMake(0, mapSize),
+                                   &memArea,
+                                   BUS_MAP_FB_FLAGS_MAP_UNICAST,
+                                   NULL);
+
+    if (status != NV_OK)
+    {
+        //
+        // Most likely a contiguous BAR1 VA range of mapSize could not be found
+        // (BAR1 VA exhausted or fragmented, cf. the deferred multi-range work).
+        // Log it: otherwise the failure is invisible and the caller silently
+        // falls back off BAR1 P2P.
+        //
+        NV_PRINTF(LEVEL_ERROR,
+                  "METHOD3: dynamic BAR1 P2P map GPU%u->GPU%u hMem 0x%x size 0x%llx "
+                  "failed (0x%x); BAR1 VA exhausted/fragmented?\n",
+                  gpuGetInstance(pMappingGpu), gpuGetInstance(pRemoteGpu),
+                  hDupMemory, mapSize, status);
+        goto fail;
+    }
+
+    bMapped = NV_TRUE;
+    pMap->bBar1Mapped = NV_TRUE;
+    pMap->memArea = memArea;
+
+    //
+    // The linear encode (windowBase + offsetWithinAllocation) assumes one
+    // contiguous BAR1 VA range. A multi-range mapping would be silent data
+    // corruption, so verify explicitly rather than trust the flag.
+    //
+    if ((memArea.numRanges != 1) || (memArea.pRanges == NULL) ||
+        (memArea.pRanges[0].size < mapSize) ||
+        (memArea.pRanges[0].size > bar1Size) ||
+        (memArea.pRanges[0].start > bar1Size - memArea.pRanges[0].size))
+    {
+        NV_PRINTF(LEVEL_ERROR,
+                  "METHOD3: invalid dynamic BAR1 P2P window (ranges=%llu start=0x%llx "
+                  "size=0x%llx requested=0x%llx BAR1=0x%llx) on GPU%u; aborting\n",
+                  memArea.numRanges,
+                  (memArea.pRanges != NULL) ? memArea.pRanges[0].start : 0,
+                  (memArea.pRanges != NULL) ? memArea.pRanges[0].size : 0,
+                  mapSize, bar1Size, gpuGetInstance(pRemoteGpu));
+        status = NV_ERR_INVALID_ADDRESS;
+        goto fail;
+    }
+
+    // ponytail: charge every logical map, even if the native allocator reuses
+    // a physical range. This may reject early but avoids a cross-client range
+    // ownership registry and can never undercount a live Method3 map.
+    if (memArea.pRanges[0].size > mapSize)
+    {
+        NvU64 extraBytes = memArea.pRanges[0].size - mapSize;
+
+        if (!portSafeAddU64(pRemoteKernelBus->p2pPcieBar1.dynamicBar1P2pMappedBytes,
+                            extraBytes,
+                            &pRemoteKernelBus->p2pPcieBar1.dynamicBar1P2pMappedBytes))
+        {
+            status = NV_ERR_INVALID_ADDRESS;
+            goto fail;
+        }
+        pMap->bar1MappedBytes = memArea.pRanges[0].size;
+    }
+
+    if (pRemoteKernelBus->p2pPcieBar1.dynamicBar1P2pMappedBytes >
+        (bar1Size - DYN_BAR1_P2P_RESERVE))
+    {
+        NV_PRINTF(LEVEL_ERROR,
+                  "METHOD3: dynamic BAR1 allocator rounded GPU%u window "
+                  "past the reserved budget (mapped=0x%llx limit=0x%llx)\n",
+                  gpuGetInstance(pRemoteGpu),
+                  pRemoteKernelBus->p2pPcieBar1.dynamicBar1P2pMappedBytes,
+                  bar1Size - DYN_BAR1_P2P_RESERVE);
+        status = NV_ERR_INSUFFICIENT_RESOURCES;
+        goto fail;
+    }
+
+    if (gpumgrGetGpuPhysFbAddr(pRemoteGpu) >
+        NV_U64_MAX - memArea.pRanges[0].start)
+    {
+        NV_PRINTF(LEVEL_ERROR,
+                  "METHOD3: dynamic BAR1 P2P window physical address overflows "
+                  "on GPU%u\n", gpuGetInstance(pRemoteGpu));
+        status = NV_ERR_INVALID_ADDRESS;
+        goto fail;
+    }
+
+    windowPhys = gpumgrGetGpuPhysFbAddr(pRemoteGpu) + memArea.pRanges[0].start;
+    if (windowPhys > NV_U64_MAX - (mapSize - 1))
+    {
+        NV_PRINTF(LEVEL_ERROR,
+                  "METHOD3: dynamic BAR1 P2P window physical range overflows "
+                  "on GPU%u (base=0x%llx size=0x%llx)\n",
+                  gpuGetInstance(pRemoteGpu), windowPhys, mapSize);
+        status = NV_ERR_INVALID_ADDRESS;
+        goto fail;
+    }
+
+    // 2. Describe the remote BAR1 window as sysmem; IOMMU-map into the source GPU.
+    //
+    // METHOD3: the window memdesc MUST be owned by pRemoteGpu (the FB/BAR1
+    // owner), NOT pMappingGpu. osIovaMap() resolves the "peer" device from
+    // memdescGetRootMemDesc(pMemDesc)->pGpu and tests the described physical
+    // address with IS_FB_OFFSET(peer, ...). windowPhys lives in pRemoteGpu's
+    // BAR1 (FB) aperture, so peer must be pRemoteGpu for IS_FB_OFFSET to hit
+    // and route through nv_dma_map_peer() (the cross-device BAR DMA path the
+    // static BAR1 mapping uses: kbusEnableStaticBar1Mapping_TU102 creates
+    // staticBar1.pDmaMemDesc with pGpu == FB owner, then maps it into the
+    // source GPU's iovaspace). With pMappingGpu as owner, IS_FB_OFFSET checks
+    // the LOCAL GPU's BAR and fails, so osIovaMap falls to the pPriv == NULL
+    // branch and returns NV_ERR_INVALID_STATE.
+    //
+    NV_CHECK_OK_OR_GOTO(status, LEVEL_ERROR,
+        memdescCreate(&pWin, pRemoteGpu, mapSize, 0, NV_MEMORY_CONTIGUOUS,
+                      ADDR_SYSMEM, NV_MEMORY_UNCACHED, MEMDESC_FLAGS_NONE),
+                      fail);
+    pMap->pWindowMemDesc = pWin;
+    memdescDescribe(pWin, ADDR_SYSMEM, windowPhys, mapSize);
+
+    NV_CHECK_OK_OR_GOTO(status, LEVEL_ERROR,
+        memdescMapIommu(pWin, iovaspaceId),
+        fail);
+
+    // memdescGetPtePhysAddrsForGpu() is void and falls back to the physical
+    // memdesc if no IOVA mapping exists. Do not accept that fallback here:
+    // this path must use the source-GPU DMA mapping created above. A zero DMA
+    // base is valid, so presence of the mapping—not dmaBase != 0—is the test.
+    pIovaMap = memdescGetIommuMap(pWin, iovaspaceId);
+    if ((pIovaMap == NULL) || (pIovaMap->pPhysMemDesc == NULL) ||
+        (pIovaMap->iovaArray[0] == NV_U64_MAX) ||
+        !memdescGetContiguity(pWin, AT_GPU))
+    {
+        NV_PRINTF(LEVEL_ERROR,
+                  "METHOD3: source GPU%u IOVA mapping missing for dynamic BAR1 "
+                  "window on GPU%u\n",
+                  gpuGetInstance(pMappingGpu), gpuGetInstance(pRemoteGpu));
+        status = NV_ERR_INVALID_STATE;
+        goto fail;
+    }
+    bIommuMapped = NV_TRUE;
+    pMap->bIommuMapped = NV_TRUE;
+
+    memdescGetPtePhysAddrsForGpu(pWin, pMappingGpu, AT_GPU, 0, 0, 1, &dmaBase);
+
+    // Cross-check the void-returning helper against the IOVA mapping itself;
+    // this makes a silent physical-array fallback or a wrapped PteAdjust
+    // observable before any PTE is handed to UVM.
+    if (pIovaMap->iovaArray[0] > NV_U64_MAX - memdescGetPteAdjust(pWin))
+    {
+        status = NV_ERR_INVALID_ADDRESS;
+        goto fail;
+    }
+    dmaBaseFromMap = pIovaMap->iovaArray[0] + memdescGetPteAdjust(pWin);
+    if (dmaBase != dmaBaseFromMap)
+    {
+        NV_PRINTF(LEVEL_ERROR,
+                  "METHOD3: source GPU%u DMA base mismatch (helper=0x%llx "
+                  "map=0x%llx)\n",
+                  gpuGetInstance(pMappingGpu), dmaBase, dmaBaseFromMap);
+        status = NV_ERR_INVALID_STATE;
+        goto fail;
+    }
+
+    // The Linux DMA mapping contract reports failure through NV_STATUS; the
+    // range check below also rejects a wrapped/sentinel address without
+    // rejecting a legitimate IOVA of zero.
+    if ((dmaBase == NV_U64_MAX) ||
+        (dmaBase > NV_U64_MAX - (mapSize - 1)))
+    {
+        NV_PRINTF(LEVEL_ERROR,
+                  "METHOD3: invalid source GPU%u DMA range for dynamic BAR1 "
+                  "window (base=0x%llx size=0x%llx)\n",
+                  gpuGetInstance(pMappingGpu), dmaBase, mapSize);
+        status = NV_ERR_INVALID_ADDRESS;
+        goto fail;
+    }
+
+    // memdescMapIommu() validates the descriptor against its owner GPU. Here
+    // the resulting IOVA is consumed by the source GPU, so apply the source
+    // GPU's address-width limit as well. This also covers the direct-bus
+    // fallback in nv_dma_map_peer(), which has no DMA-mask validation of its
+    // own. Keep zero valid: it is a legal lower-bound IOVA.
+    dmaWindowEndAddr = gpuGetDmaEndAddress_HAL(pMappingGpu);
+    if ((dmaBase > dmaWindowEndAddr) ||
+        ((mapSize - 1) > (dmaWindowEndAddr - dmaBase)))
+    {
+        NV_PRINTF(LEVEL_ERROR,
+                  "METHOD3: source GPU%u DMA range 0x%llx-0x%llx exceeds "
+                  "addressable limit 0x%llx\n",
+                  gpuGetInstance(pMappingGpu), dmaBase,
+                  dmaBase + mapSize - 1, dmaWindowEndAddr);
+        status = NV_ERR_INVALID_ADDRESS;
+        goto fail;
+    }
+
+    // 3. Track it.
+    pMap->windowDmaBase = dmaBase;
+
+    pMap->pNext = rmSubDevice->pDynBar1List;
+    rmSubDevice->pDynBar1List = pMap;
+
+    NV_PRINTF(LEVEL_INFO,
+              "METHOD3: dynamic BAR1 P2P map GPU%u->GPU%u hMem 0x%x size 0x%llx "
+              "bar1Off 0x%llx dmaBase 0x%llx (total 0x%llx)\n",
+              gpuGetInstance(pMappingGpu), gpuGetInstance(pRemoteGpu), hDupMemory,
+              mapSize, memArea.pRanges[0].start, dmaBase,
+              pRemoteKernelBus->p2pPcieBar1.dynamicBar1P2pMappedBytes);
+
+    if (bRemoteLockAcquired)
+    {
+        releaseStatus = rmDeviceGpuLocksRelease(pRemoteGpu,
+                                                 GPUS_LOCK_FLAGS_NONE, NULL);
+        bRemoteLockAcquired = NV_FALSE;
+        if (releaseStatus == NV_SEMA_RELEASE_FAILED)
+        {
+            NV_PRINTF(LEVEL_ERROR,
+                      "METHOD3: remote GPU%u lock release returned %u after "
+                      "dynamic BAR1 create hMem 0x%x\n",
+                      gpuGetInstance(pRemoteGpu), releaseStatus, hDupMemory);
+        }
+    }
+
+    *pWindowDmaBase = dmaBase;
+    return NV_OK;
+
+fail:
+    {
+        NV_STATUS unmapStatus = NV_OK;
+
+        if (bMapped)
+        {
+            // The remote lock is held from the budget reservation through map
+            // validation and cleanup.  Never retry an unmap without proving
+            // that ownership first.
+            if ((bRemoteLockTaken || bRemoteLockAcquired) &&
+                (memArea.pRanges != NULL) && (memArea.numRanges != 0))
+            {
+                unmapStatus = _nvGpuOpsDynBar1Unmap(pMap, pRemoteKernelBus);
+                if (unmapStatus != NV_OK)
+                {
+                    NV_PRINTF(LEVEL_ERROR,
+                              "METHOD3: dynamic BAR1 cleanup unmap GPU%u->GPU%u "
+                              "hMem 0x%x failed (0x%x)\n",
+                              gpuGetInstance(pMappingGpu), gpuGetInstance(pRemoteGpu),
+                              hDupMemory, unmapStatus);
+                }
+                else
+                {
+                    bMapped = NV_FALSE;
+                    pMap->bBar1Mapped = NV_FALSE;
+                    memArea.pRanges = NULL;
+                    memArea.numRanges = 0;
+                }
+            }
+            else
+            {
+                NV_PRINTF(LEVEL_ERROR,
+                          "METHOD3: dynamic BAR1 cleanup skipped unmap for "
+                          "GPU%u hMem 0x%x because lock or MemoryArea was invalid\n",
+                          gpuGetInstance(pRemoteGpu), hDupMemory);
+                unmapStatus = NV_ERR_INVALID_LOCK_STATE;
+            }
+        }
+
+        // A failed unmap leaves the remote aperture, IOMMU descriptor, budget,
+        // and descriptor reference live. Retain a tombstone in the list so a
+        // later handle free can retry the exact unmap; never expose its DMA
+        // base to a new PTE request.
+        if (bMapped)
+        {
+            pMap->memArea = memArea;
+            pMap->bBar1Mapped = NV_TRUE;
+            pMap->bIommuMapped = bIommuMapped;
+            pMap->pWindowMemDesc = pWin;
+            pMap->bCleanupPending = NV_TRUE;
+            pMap->pNext = rmSubDevice->pDynBar1List;
+            rmSubDevice->pDynBar1List = pMap;
+            pMap = NULL;
+        }
+        else
+        {
+            if (bIommuMapped && (pWin != NULL) &&
+                (memdescGetIommuMap(pWin, iovaspaceId) != NULL))
+            {
+                memdescUnmapIommu(pWin, iovaspaceId);
+                bIommuMapped = NV_FALSE;
+            }
+            if (pWin != NULL)
+                memdescDestroy(pWin);
+
+            if (bBudgetReserved)
+            {
+                NvU64 budgetBytes = (pMap != NULL) ? pMap->bar1MappedBytes : mapSize;
+
+                if (pRemoteKernelBus->p2pPcieBar1.dynamicBar1P2pMappedBytes < budgetBytes)
+                {
+                    NV_PRINTF(LEVEL_ERROR,
+                              "METHOD3: dynamic BAR1 budget underflow during "
+                              "create cleanup (mapped=0x%llx charge=0x%llx)\n",
+                              pRemoteKernelBus->p2pPcieBar1.dynamicBar1P2pMappedBytes,
+                              budgetBytes);
+                    // Poison admission until the next BAR1 generation rather
+                    // than undercount any surviving mapping.
+                    pRemoteKernelBus->p2pPcieBar1.dynamicBar1P2pMappedBytes =
+                        NV_U64_MAX;
+                    status = NV_ERR_INVALID_STATE;
+                }
+                else
+                {
+                    pRemoteKernelBus->p2pPcieBar1.dynamicBar1P2pMappedBytes -= budgetBytes;
+                }
+                bBudgetReserved = NV_FALSE;
+            }
+
+            if (pMap != NULL)
+            {
+                if (pMap->bAllocMemDescRef)
+                {
+                    memdescDestroy(pMap->pAllocMemDesc);
+                    pMap->bAllocMemDescRef = NV_FALSE;
+                }
+                portMemFree(pMap);
+                pMap = NULL;
+            }
+        }
+    }
+
+    if (bRemoteLockAcquired)
+    {
+        releaseStatus = rmDeviceGpuLocksRelease(pRemoteGpu,
+                                                 GPUS_LOCK_FLAGS_NONE, NULL);
+        bRemoteLockAcquired = NV_FALSE;
+        if (releaseStatus == NV_SEMA_RELEASE_FAILED)
+        {
+            NV_PRINTF(LEVEL_ERROR,
+                      "METHOD3: remote GPU%u lock release returned %u after "
+                      "dynamic BAR1 create failure hMem 0x%x\n",
+                      gpuGetInstance(pRemoteGpu), releaseStatus, hDupMemory);
+        }
+    }
+    return status;
+}
+
+// Look up, or lazily create, the dynamic BAR1 P2P window for a duped peer alloc.
+static NV_STATUS
+_nvGpuOpsDynBar1GetOrCreate(subDeviceDesc *rmSubDevice,
+                            OBJGPU *pMappingGpu,
+                            OBJGPU *pRemoteGpu,
+                            MEMORY_DESCRIPTOR *pAllocMemDesc,
+                            NvHandle hDupMemory,
+                            RmPhysAddr *pWindowDmaBase,
+                            gpuDynBar1P2PMapping **ppLease)
+{
+    NV_STATUS status = NV_OK;
+    gpuDynBar1P2PMapping *pMap;
+    NvU64 mapRootOffset = 0;
+    NvU64 requestRootOffset = 0;
+
+    if ((rmSubDevice == NULL) || (pWindowDmaBase == NULL) || (ppLease == NULL))
+        return NV_ERR_INVALID_ARGUMENT;
+
+    *pWindowDmaBase = 0;
+    *ppLease = NULL;
+    portSyncMutexAcquire(rmSubDevice->pDynBar1Mutex);
+    pMap = _nvGpuOpsDynBar1Find(rmSubDevice, hDupMemory);
+    if (pMap != NULL)
+    {
+        if (pMap->bDestroying || pMap->bCleanupPending)
+            status = NV_ERR_STATE_IN_USE;
+        else if ((pMap->mappingGpuInstance != gpuGetInstance(pMappingGpu)) ||
+                 (pMap->mappingGpuId != pMappingGpu->gpuId) ||
+                 (pMap->pMappingGpu != pMappingGpu) ||
+                 (pMap->remoteGpuInstance != gpuGetInstance(pRemoteGpu)) ||
+                 (pMap->remoteGpuId != pRemoteGpu->gpuId) ||
+                 (pMap->pRemoteGpu != pRemoteGpu) ||
+                 (GPU_GET_KERNEL_BUS(pMappingGpu) == NULL) ||
+                 (GPU_GET_KERNEL_BUS(pRemoteGpu) == NULL) ||
+                 (pMap->mappingBar1Generation !=
+                      GPU_GET_KERNEL_BUS(pMappingGpu)->p2pPcieBar1.dynamicBar1P2pGeneration) ||
+                 (pMap->remoteBar1Generation !=
+                      GPU_GET_KERNEL_BUS(pRemoteGpu)->p2pPcieBar1.dynamicBar1P2pGeneration) ||
+                 (pMap->pAllocMemDesc == NULL) ||
+                 (pMap->size != memdescGetSize(pAllocMemDesc)) ||
+                 (memdescGetRootMemDesc(pMap->pAllocMemDesc, &mapRootOffset) !=
+                      memdescGetRootMemDesc(pAllocMemDesc, &requestRootOffset)) ||
+                 (mapRootOffset != requestRootOffset))
+        {
+            NV_PRINTF(LEVEL_ERROR,
+                      "METHOD3: dynamic BAR1 handle 0x%x was requested with "
+                      "inconsistent GPU or allocation identity\n", hDupMemory);
+            status = NV_ERR_INVALID_STATE;
+        }
+        else
+        {
+            if (pMap->activeUsers == NV_U32_MAX)
+                status = NV_ERR_INSUFFICIENT_RESOURCES;
+            else
+            {
+                ++pMap->activeUsers;
+                *pWindowDmaBase = pMap->windowDmaBase;
+                *ppLease = pMap;
+            }
+        }
+    }
+    else
+    {
+        status = _nvGpuOpsDynBar1Create(rmSubDevice, pMappingGpu, pRemoteGpu,
+                                        pAllocMemDesc, hDupMemory, pWindowDmaBase);
+        if (status == NV_OK)
+        {
+            // Create inserts the record while this mutex is held. Take the
+            // lease before releasing it so teardown cannot race the first
+            // PTE/phys-address build.
+            pMap = _nvGpuOpsDynBar1Find(rmSubDevice, hDupMemory);
+            if (pMap == NULL)
+            {
+                status = NV_ERR_INVALID_STATE;
+                *pWindowDmaBase = 0;
+            }
+            else
+            {
+                ++pMap->activeUsers;
+                *ppLease = pMap;
+            }
+        }
+    }
+    portSyncMutexRelease(rmSubDevice->pDynBar1Mutex);
+    return status;
+}
+
+// Drop a short-lived PTE/phys-address lease. The mapping record cannot be
+// freed while a lease is held; teardown returns NV_ERR_STATE_IN_USE instead.
+static void
+_nvGpuOpsDynBar1ReleaseLease(subDeviceDesc *rmSubDevice,
+                             gpuDynBar1P2PMapping *pMap)
+{
+    if ((rmSubDevice == NULL) || (pMap == NULL) ||
+        (rmSubDevice->pDynBar1Mutex == NULL))
+        return;
+
+    portSyncMutexAcquire(rmSubDevice->pDynBar1Mutex);
+    NV_ASSERT(pMap->activeUsers != 0);
+    if (pMap->activeUsers != 0)
+        --pMap->activeUsers;
+    portSyncMutexRelease(rmSubDevice->pDynBar1Mutex);
+}
+
+// Tear down and free the dynamic BAR1 P2P window for a duped peer alloc, if any.
+static NV_STATUS
+_nvGpuOpsDynBar1Destroy(subDeviceDesc *rmSubDevice, NvHandle hDupMemory)
+{
+    gpuDynBar1P2PMapping *pMap = NULL;
+    gpuDynBar1P2PMapping *pCur;
+    KernelBus *pRemoteKernelBus = NULL;
+    NV_STATUS status = NV_OK;
+    NvBool bRemoteLockTaken;
+    NvBool bRemoteLockAcquired = NV_FALSE;
+    NvU32 releaseStatus;
+
+    if ((rmSubDevice == NULL) || (rmSubDevice->pDynBar1Mutex == NULL))
+        return NV_ERR_INVALID_STATE;
+
+    portSyncMutexAcquire(rmSubDevice->pDynBar1Mutex);
+    for (pCur = rmSubDevice->pDynBar1List; pCur != NULL; pCur = pCur->pNext)
+    {
+        if (pCur->hDupMemory == hDupMemory)
+        {
+            pMap = pCur;
+            break;
+        }
+    }
+    if ((pMap != NULL) && (pMap->bDestroying || (pMap->activeUsers != 0)))
+    {
+        portSyncMutexRelease(rmSubDevice->pDynBar1Mutex);
+        return NV_ERR_STATE_IN_USE;
+    }
+    if (pMap != NULL)
+        pMap->bDestroying = NV_TRUE;
+    portSyncMutexRelease(rmSubDevice->pDynBar1Mutex);
+
+    if (pMap == NULL)
+        return NV_OK;
+
+    // OBJGPU has no retain API.  The RM read lock held by callers serializes
+    // this identity check against detach; do not dereference the saved pointer
+    // until it is present in the current attach table with the same GPU id.
+    if (!rmapiLockIsOwner())
+    {
+        status = NV_ERR_INVALID_LOCK_STATE;
+        goto fail;
+    }
+
+    if (!gpumgrIsGpuPointerAttached(pMap->pMappingGpu) ||
+        (gpumgrGetGpuFromId(pMap->mappingGpuId) != pMap->pMappingGpu) ||
+        !gpumgrIsGpuPointerAttached(pMap->pRemoteGpu) ||
+        (gpumgrGetGpuFromId(pMap->remoteGpuId) != pMap->pRemoteGpu))
+    {
+        // The native BAR1 reuse database embeds a memdesc destroy callback in
+        // GPU-owned state. Once that GPU is gone, neither unmapping nor freeing
+        // the retained memdesc is safe. Fail closed and keep the device/handle
+        // pinned until reboot instead of risking a stale callback dereference.
+        NV_PRINTF(LEVEL_ERROR,
+                  "METHOD3: source GPU%u or remote GPU%u detached/replaced "
+                  "before dynamic BAR1 unmap hMem 0x%x; retaining mapping "
+                  "state until reboot\n",
+                  pMap->mappingGpuInstance, pMap->remoteGpuInstance, hDupMemory);
+        status = NV_ERR_GPU_IS_LOST;
+        goto fail;
+    }
+
+    if ((GPU_GET_KERNEL_BUS(pMap->pMappingGpu) == NULL) ||
+        (GPU_GET_KERNEL_BUS(pMap->pRemoteGpu) == NULL) ||
+        (pMap->mappingBar1Generation !=
+             GPU_GET_KERNEL_BUS(pMap->pMappingGpu)->p2pPcieBar1.dynamicBar1P2pGeneration) ||
+        (pMap->remoteBar1Generation !=
+             GPU_GET_KERNEL_BUS(pMap->pRemoteGpu)->p2pPcieBar1.dynamicBar1P2pGeneration))
+    {
+        NV_PRINTF(LEVEL_ERROR,
+                  "METHOD3: BAR1 generation changed before dynamic unmap "
+                  "hMem 0x%x; retaining mapping state until reboot\n",
+                  hDupMemory);
+        status = NV_ERR_GPU_IS_LOST;
+        goto fail;
+    }
+
+    if (pMap->pRemoteGpu == NULL || pMap->pAllocMemDesc == NULL ||
+        !pMap->bBar1Mapped || (pMap->memArea.pRanges == NULL) ||
+        (pMap->memArea.numRanges == 0))
+    {
+        NV_PRINTF(LEVEL_ERROR,
+                  "METHOD3: invalid dynamic BAR1 mapping state for hMem 0x%x\n",
+                  hDupMemory);
+        status = NV_ERR_INVALID_STATE;
+        goto fail;
+    }
+
+    NV_PRINTF(LEVEL_INFO,
+              "METHOD3: dynamic BAR1 P2P unmap GPU%u hMem 0x%x size 0x%llx\n",
+              pMap->remoteGpuInstance, hDupMemory, pMap->size);
+
+    pRemoteKernelBus = GPU_GET_KERNEL_BUS(pMap->pRemoteGpu);
+    bRemoteLockTaken = rmDeviceGpuLockIsOwner(pMap->remoteGpuInstance);
+
+    if (pRemoteKernelBus == NULL)
+    {
+        status = NV_ERR_INVALID_STATE;
+        goto fail;
+    }
+
+    if (!bRemoteLockTaken)
+    {
+        status = rmDeviceGpuLocksAcquire(pMap->pRemoteGpu,
+                                          GPUS_LOCK_FLAGS_NONE,
+                                          RM_LOCK_MODULES_P2P);
+        if (status != NV_OK)
+        {
+            NV_PRINTF(LEVEL_ERROR,
+                      "METHOD3: dynamic BAR1 P2P remote GPU%u lock failed for "
+                      "hMem 0x%x (0x%x)\n",
+                      pMap->remoteGpuInstance, hDupMemory, status);
+            // Keep the complete record and duped handle for a later retry.
+            // Calling the BAR1 unmap without this lock would be unsafe.
+            goto fail;
+        }
+        else
+        {
+            bRemoteLockAcquired = NV_TRUE;
+        }
+    }
+
+    // Keep the window descriptor alive until the BAR1 mapping is gone.  If
+    // unmap fails, the record and duped handle remain retryable.
+    status = _nvGpuOpsDynBar1Unmap(pMap, pRemoteKernelBus);
+    if (status != NV_OK)
+    {
+        NV_PRINTF(LEVEL_ERROR,
+                  "METHOD3: dynamic BAR1 P2P unmap GPU%u hMem 0x%x "
+                  "failed (0x%x); retaining mapping for retry\n",
+                  pMap->remoteGpuInstance, hDupMemory, status);
+        goto fail;
+    }
+    pMap->bBar1Mapped = NV_FALSE;
+
+    // The remote-global reservation is serialized by this same GPU lock.
+    if (pRemoteKernelBus->p2pPcieBar1.dynamicBar1P2pMappedBytes <
+        pMap->bar1MappedBytes)
+    {
+        NV_PRINTF(LEVEL_ERROR,
+                  "METHOD3: dynamic BAR1 budget underflow during destroy "
+                  "(mapped=0x%llx charge=0x%llx)\n",
+                  pRemoteKernelBus->p2pPcieBar1.dynamicBar1P2pMappedBytes,
+                  pMap->bar1MappedBytes);
+        // The native unmap already succeeded, so release the handle/resources
+        // but poison further Method3 admission for this BAR1 generation.
+        pRemoteKernelBus->p2pPcieBar1.dynamicBar1P2pMappedBytes = NV_U64_MAX;
+    }
+    else
+    {
+        pRemoteKernelBus->p2pPcieBar1.dynamicBar1P2pMappedBytes -=
+            pMap->bar1MappedBytes;
+    }
+
+    if (bRemoteLockAcquired)
+    {
+        releaseStatus = rmDeviceGpuLocksRelease(pMap->pRemoteGpu,
+                                                 GPUS_LOCK_FLAGS_NONE, NULL);
+        bRemoteLockAcquired = NV_FALSE;
+        if (releaseStatus == NV_SEMA_RELEASE_FAILED)
+        {
+            NV_PRINTF(LEVEL_ERROR,
+                      "METHOD3: remote GPU%u lock release returned %u after "
+                      "dynamic BAR1 P2P unmap hMem 0x%x\n",
+                      pMap->remoteGpuInstance, releaseStatus, hDupMemory);
+        }
+    }
+
+    // Release the source IOMMU mapping only after the remote BAR1 mapping is
+    // gone. It is legal for teardown to have already removed this mapping.
+    if (pMap->pWindowMemDesc != NULL && pMap->bIommuMapped &&
+        (memdescGetIommuMap(pMap->pWindowMemDesc, pMap->iovaspaceId) != NULL))
+        memdescUnmapIommu(pMap->pWindowMemDesc, pMap->iovaspaceId);
+    else if (pMap->pWindowMemDesc != NULL)
+        NV_PRINTF(LEVEL_WARNING,
+                  "METHOD3: dynamic BAR1 P2P IOMMU map already absent for "
+                  "hMem 0x%x\n", hDupMemory);
+    if (pMap->pWindowMemDesc != NULL)
+        memdescDestroy(pMap->pWindowMemDesc);
+    if (pMap->bAllocMemDescRef)
+        memdescDestroy(pMap->pAllocMemDesc);
+
+    // Only make the mapping reusable after every backing resource has been
+    // released. bDestroying prevents a concurrent PTE build/free from using
+    // the record while the remote BAR1 operation is in flight.
+    _nvGpuOpsDynBar1Remove(rmSubDevice, pMap);
+    return status;
+
+fail:
+    if (bRemoteLockAcquired)
+    {
+        releaseStatus = rmDeviceGpuLocksRelease(pMap->pRemoteGpu,
+                                                 GPUS_LOCK_FLAGS_NONE, NULL);
+        if (releaseStatus == NV_SEMA_RELEASE_FAILED)
+        {
+            NV_PRINTF(LEVEL_ERROR,
+                      "METHOD3: remote GPU%u lock release returned %u after "
+                      "dynamic BAR1 P2P cleanup failure hMem 0x%x\n",
+                      pMap->remoteGpuInstance, releaseStatus, hDupMemory);
+        }
+    }
+
+    // Attached-GPU failures are fail-closed: preserve the BAR1 mapping,
